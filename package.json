{
  "name": "@threecore/wallet-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ThreeCore DAT/EMA/CAWELON EIP-1193 browser-wallet connection and read-only EVM integration",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "npm test",
    "demo": "node examples/dev-server.js",
    "test:demo-server": "node --test integration/demo-server.test.mjs",
    "test:browser-ui": "node scripts/test-browser-ui.js",
    "liquidity:progress": "node scripts/liquidity-progress.js",
    "census": "node scripts/codebase-census.js",
    "backup:check": "node scripts/check-workspace-backup.js",
    "checkpoints:check": "node scripts/check-checkpoint-collection.js",
    "identity:check": "node scripts/check-token-identity.js",
    "allowance:check": "node scripts/check-allowance-file.js",
    "transfers:check": "node scripts/check-transfer-file.js",
    "test:transfer-server": "node --test integration/transfer-server.test.mjs",
    "test:allowance-server": "node --test integration/allowance-server.test.mjs",
    "test:identity-server": "node --test integration/token-identity-server.test.mjs",
    "test:external-dapp": "node scripts/run-isolated-aerodrome-probe.js --mock-wallet",
    "inspect:external-dapp": "node scripts/run-isolated-aerodrome-probe.js",
    "vault:check": "node scripts/check-transfer-vault.js",
    "reconciliation:check": "node scripts/check-reconciliation.js",
    "period:check": "node scripts/check-period.js",
    "period-library:check": "node scripts/check-period-library.js"
  }
}
