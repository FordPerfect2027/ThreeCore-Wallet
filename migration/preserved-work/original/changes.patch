+  /**
+   * A provider can change its RPC chain without emitting chainChanged.
+   * Verify the network again after each read before exposing the response.
+   * Never retry a failed or wrong-network read against another chain.
+   */
+  async #readOnExpectedChain(epoch, method, params) {
+    this.#assertReadEpoch(epoch);
+    const result = await this.#provider.request({ method, params });
+    this.#assertReadEpoch(epoch);
+    await this.#confirmChain(epoch, true);
+    return result;
+  }
