{
  "name": "@0628dao/datcore",
  "version": "0.1.0",
  "description": "DATCORE fixed-supply ERC-20 and Base Sepolia testnet publication",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "node scripts/check-contract-source.js && hardhat compile",
    "test": "node scripts/test-contracts.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run test:source && npm run test:toolchain && npm run compile && npm run test && npm run typecheck && npm run test:read-only && npm run test:history",
    "test:toolchain": "node --test integration/toolchain-data.test.mjs",
    "test:source": "node --test integration/source-portability.test.mjs integration/test-routing.test.mjs",
    "test:history": "node --test integration/history-compatibility.test.mjs",
    "cmc:market-context": "node scripts/cmc-market-context.ts",
    "deploy:base-sepolia": "hardhat run scripts/deploy-base-sepolia.ts --network baseSepolia",
    "verify:base-sepolia": "node scripts/verify-base-sepolia.js",
    "test:identity": "node --test test/onchain-identity.test.mjs",
    "verify:base-mainnet": "node scripts/verify-base-mainnet.js",
    "test:read-only": "node --test --test-concurrency=1 test/*.test.mjs",
    "inspect:transfers": "node scripts/inspect-transfers.js",
    "inspect:wallet": "node scripts/inspect-wallet-readiness.js",
    "inspect:approvals": "node scripts/inspect-approvals.js",
    "quote:dex": "node scripts/quote-dex.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.56.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-keystore": "3.1.2",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.2",
    "@nomicfoundation/hardhat-viem": "3.1.0",
    "@types/node": "22.8.5",
    "hardhat": "3.21.2",
    "solc": "0.8.34",
    "typescript": "6.0.3"
  },
  "overrides": {
    "follow-redirects": "1.16.2",
    "undici@^6.0.0": "6.29.1",
    "undici@^7.0.0": "7.30.1",
    "@nomicfoundation/hardhat-utils@^5.0.0": "5.1.1",
    "@nomicfoundation/hardhat-zod-utils": "3.0.8",
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
