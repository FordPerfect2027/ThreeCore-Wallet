{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2023",
    "strict": true,
    "skipLibCheck": false,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist/src",
    "paths": {
      "@nomicfoundation/hardhat-zod-utils": [
        "./src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
