+++ b/vendor/README.md
@@ -0,0 +1,18 @@
+# Local Zod 4 development candidate
+
+helper.tgz is a private ThreeCore migration of Nomic Foundation's MIT-licensed
+hardhat-zod-utils 3.0.8. It is version 3.0.8-threecore-zod4.1, not an upstream
+release. The archive contains TypeScript source, regenerated declarations/JS,
+license and build configuration. helper-migration.patch is the source delta.
+
+Zod is pinned to 4.6.6. Compiler, OpenZeppelin, viem, Hardhat and other package
+versions remain unchanged. The package has no lifecycle install scripts.
+Archive SHA-256: 1013b53b9eb2c2cdead0e16a0be8a9e5397db31e38a446f4d67b4483e5e9abf1.
+
+This is a review candidate. Local compilation, strict helper/type fixtures,
+read-only tests and bounded schema checks passed in isolated installations.
+This candidate is applied to the local development source and installed dependencies.
+Previously sealed review packages and public repositories are unchanged.
+Contract-execution/signing suites were not rerun for this candidate.
+No user wallet, private key or public transaction is required for the recorded checks.
+Independent review and an explicit release decision remain open.
diff --git a/vendor/helper-migration.patch b/vendor/helper-migration.patch
new file mode 100644
index 0000000..229f449
--- /dev/null
+++ b/vendor/helper-migration.patch
@@ -0,0 +1,65 @@
+diff --git a/src/index.ts b/src/index.ts
+index 0d34086..a14c427 100644
+--- a/src/index.ts
++++ b/src/index.ts
+@@ -1,4 +1,4 @@
+-import type { ZodTypeDef, ZodType } from "zod";
++import type { ZodType } from "zod";
+ 
+ import { z } from "zod";
+ 
+@@ -30,7 +30,7 @@ export interface HardhatUserConfigValidationError {
+  */
+ // TODO: improve the return type of this function to be more specific
+ export const unionType = (
+-  types: Parameters<typeof z.union>[0],
++  types: readonly z.ZodType[],
+   errorMessage: string,
+ ) =>
+   // NOTE: The reason we use `z.any().superRefine` instead of `z.union` is that
+@@ -100,7 +100,7 @@ export const conditionalUnionType = (
+     const parsedData = zodType.safeParse(data);
+     if (parsedData.error !== undefined) {
+       for (const issue of parsedData.error.issues) {
+-        ctx.addIssue(issue);
++        ctx.addIssue({ ...issue });
+       }
+     }
+   });
+@@ -137,11 +137,7 @@ export const conditionalUnionType = (
+  */
+ export const incompatibleFieldType = (errorMessage = "Unexpected field") =>
+   z
+-    .never({
+-      errorMap: () => ({
+-        message: errorMessage,
+-      }),
+-    })
++    .never({ error: () => errorMessage })
+     .optional();
+ 
+ /**
+@@ -205,19 +201,18 @@ export const sensitiveUrlSchema: z.ZodType<
+  */
+ export function validateUserConfigZodType<
+   Output,
+-  Def extends ZodTypeDef = ZodTypeDef,
+-  Input = Output,
++  Input = unknown,
+ >(
+   hardhatUserConfig: HardhatUserConfigToValidate,
+-  configType: ZodType<Output, Def, Input>,
++  configType: ZodType<Output, Input>,
+ ): HardhatUserConfigValidationError[] {
+   const result = configType.safeParse(hardhatUserConfig);
+ 
+   if (result.success) {
+     return [];
+   } else {
+-    return result.error.errors.map((issue) => ({
+-      path: issue.path,
++    return result.error.issues.map((issue) => ({
++      path: issue.path.map((segment) => typeof segment === "symbol" ? String(segment) : segment),
+       message: issue.message,
+     }));
+   }
