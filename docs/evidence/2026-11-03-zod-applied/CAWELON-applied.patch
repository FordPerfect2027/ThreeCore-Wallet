new file mode 100644
index 0000000..1143bdf
--- /dev/null
+++ b/DEPENDENCY_SECURITY_2026-11-03.md
@@ -0,0 +1,28 @@
+# Local Zod 4 toolchain repair — November 3, 2026
+
+The development lock now uses Zod 4.6.6 and a private ThreeCore migration of
+Nomic Foundation's MIT-licensed hardhat-zod-utils 3.0.8. This fixes structured
+validation errors and type compatibility that prevented the earlier forced-major
+upgrade. It is a local development change, not an official upstream release.
+
+The source delta, archive and license are in vendor/. The archive contains the
+TypeScript source, generated declarations/JavaScript and build configuration.
+Its SHA-256 is 1013b53b9eb2c2cdead0e16a0be8a9e5397db31e38a446f4d67b4483e5e9abf1.
+Only the helper and Zod installed-package entries change. Compiler, contracts,
+Hardhat, OpenZeppelin, viem and plugin versions are unchanged.
+
+Candidate checks include clean installation without lifecycle scripts; bounded
+configuration and strict helper/type fixtures; all three token builds/type
+checks with the actual project configuration; exact ABI and complete creation/
+runtime-bytecode comparisons; DAT's 251 read-only cases. Applied installations
+also receive the eight toolchain/migration cases, forced compilation, type check
+and a dated full npm audit. Each token's application receipt is retained in the
+Wallet review evidence, separate from prior candidate checks. Overlapping and
+repeated cases are not summed into new feature counts.
+
+These checks use CI mode and a filtered environment without credentials.
+No user-wallet, private-key, signature or transaction operations are required.
+Contract-execution and local-EVM transaction suites were not rerun for this
+repair. Independent review, upkeep of this private fork and explicit release
+approval remain separate. A zero dated audit is not a token-safety guarantee.
+The original November 2 dependency finding remains in its historical report.
diff --git a/integration/zod-migration.test.mjs b/integration/zod-migration.test.mjs
new file mode 100644
index 0000000..594d727
--- /dev/null
+++ b/integration/zod-migration.test.mjs
@@ -0,0 +1,8 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {z} from 'zod';
+import {validateUserConfigZodType,conditionalUnionType,unionType} from '@nomicfoundation/hardhat-zod-utils';
+test('migrated helper keeps ordinary path segments and represents symbol labels explicitly',()=>{const schema=z.any().superRefine((value,ctx)=>ctx.addIssue({code:'custom',message:'fictional failure',path:['root',2,Symbol('probe')]}));assert.deepEqual(validateUserConfigZodType({},schema),[{path:['root',2,'Symbol(probe)'],message:'fictional failure'}]);});
+test('migrated conditional union retains strict-object failure',()=>{const schema=z.object({choice:conditionalUnionType([[(value)=>typeof value==='object'&&value!==null,z.strictObject({label:z.string()})]],'Expected object')});const errors=validateUserConfigZodType({choice:{label:'fictional',unexpected:1}},schema);assert.equal(errors.length,1);assert.deepEqual(errors[0].path,['choice']);assert.match(errors[0].message,/unexpected/i);});
+test('migrated union accepts members and rejects nonmembers',()=>{const schema=z.object({value:unionType([z.string(),z.number()],'Expected string or number')});for(const value of ['fictional',2])assert.deepEqual(validateUserConfigZodType({value},schema),[]);assert.deepEqual(validateUserConfigZodType({value:true},schema),[{path:['value'],message:'Expected string or number'}]);});
+test('oversized bounded array fails before element validation',()=>{let visits=0;const schema=z.array(z.preprocess(value=>{visits++;return value;},z.string())).max(2);const invalid=schema.safeParse([1,2,3]);assert.equal(invalid.success,false);assert.equal(invalid.error.issues.length,1);assert.equal(invalid.error.issues[0].code,'too_big');assert.equal(visits,0);assert(schema.safeParse(['one','two']).success);assert.equal(visits,2);});
