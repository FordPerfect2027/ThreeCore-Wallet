+++ b/test/sepolia-verifier-cli.test.mjs
@@ -0,0 +1,45 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { runSepoliaCli } from "./support/sepolia-cli-fixture.mjs";
+
+test("Sepolia CLI does not turn negative-probe transport errors into PASS", async () => {
+  const result = await runSepoliaCli("rpc-error-negative");
+  assert.equal(result.code, 1, "Transport failures were counted as successful rejection probes");
+  assert.equal(result.stdout, "");
+  assert(!result.stderr.includes("test-only-secret"));
+});
+
+test("Sepolia CLI emits the exact checkpoint through real viem HTTP", async () => {
+  const result = await runSepoliaCli();
+  assert.equal(result.code, 0, result.stderr); assert.equal(result.stderr, "");
+  const report = JSON.parse(result.stdout);
+  assert.equal(report.result, "PASS"); assert.equal(report.checkpointBlockNumber, "12");
+  assert.equal(report.observationScope, "recorded-post-deployment-checkpoint");
+  for (const call of result.calls.filter(c => ["eth_call", "eth_getCode"].includes(c.method))) assert.deepEqual(call.params[1], { blockHash: report.checkpointBlockHash, requireCanonical: true });
+});
+
+test("Sepolia CLI redacts endpoint and provider details on early RPC failure", async () => {
+  const result = await runSepoliaCli("early-rpc-error");
+  assert.equal(result.code, 1); assert.equal(result.stdout, "");
+  assert.equal(result.stderr, "Read-only Sepolia verification failed: RPC_ERROR\n");
+  assert.equal(result.calls.length, 1);
+});
+
+test("Sepolia CLI supports an explicit matching artifact with a space in its path", async () => {
+  const result = await runSepoliaCli("success", undefined, { useArtifactArgument: true });
+  assert.equal(result.code, 0, result.stderr); assert.equal(JSON.parse(result.stdout).result, "PASS");
+});
+
+test("Sepolia CLI refuses unknown arguments before RPC", async () => {
+  const result = await runSepoliaCli("success", undefined, { args: ["--unknown", "test-only-secret"] });
+  assert.equal(result.code, 2); assert.equal(result.stdout, ""); assert.equal(result.calls.length, 0);
+  assert(!result.stderr.includes("test-only-secret"));
+});
+
+test("Sepolia CLI enforces the real deadline after response headers", async t => {
+  const result = await runSepoliaCli("stalled-body");
+  assert.equal(result.code, 1); assert.equal(result.stdout, ""); assert.equal(result.calls.length, 1);
+  assert.equal(result.stderr, "Read-only Sepolia verification failed: RPC_ERROR\n");
+  assert(result.bodyElapsedMs < 15000);
+  t.diagnostic("Body observed to process exit: " + Math.round(result.bodyElapsedMs) + " ms");
+});
diff --git a/test/sepolia-verifier.test.mjs b/test/sepolia-verifier.test.mjs
new file mode 100644
index 0000000..fbc32ea
--- /dev/null
+++ b/test/sepolia-verifier.test.mjs
@@ -0,0 +1,56 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { verifySepoliaDeployment, SepoliaVerificationError } from "../src/sepolia-deployment-verifier.js";
+import { sepoliaFixture } from "./support/sepolia-fixture.mjs";
+
+test("recorded checkpoint binds state reads and negative simulations to one canonical hash", async () => {
+  const f = sepoliaFixture(), report = await verifySepoliaDeployment(f.client, f.deployment, f.artifact);
+  assert.equal(report.result, "PASS"); assert.equal(report.checkpointBlockNumber, "12");
+  assert.equal(report.observationScope, "recorded-post-deployment-checkpoint");
+  assert.equal(report.transactionSent, false); assert.equal(report.signatureCreated, false); assert.equal(report.currentState, undefined);
+  assert.equal(report.negativePaths.permitReplay.errorName, "ERC2612InvalidSigner");
+  assert.equal(report.negativePaths.zeroTransfer.errorName, "ERC20InvalidReceiver");
+  assert(f.calls.every(c => ["eth_chainId", "eth_getBlockByNumber", "eth_getCode", "eth_getTransactionByHash", "eth_getTransactionReceipt", "eth_call"].includes(c.method)));
+  const reads = f.calls.filter(c => ["eth_call", "eth_getCode"].includes(c.method));
+  assert.equal(reads.length, 13);
+  for (const call of reads) assert.deepEqual(call.params[1], { blockHash: report.checkpointBlockHash, requireCanonical: true });
+  assert.equal(f.calls.filter(c => c.method === "eth_getBlockByNumber").length, 6);
+  assert.equal(f.calls.filter(c => c.method === "eth_chainId").length, 2);
+});
+
+for (const [mode, code] of [
+  ["rpc-error-negative", "NEGATIVE_PROBE_RPC_ERROR"], ["permit-rpc-error", "NEGATIVE_PROBE_RPC_ERROR"], ["transfer-rpc-error", "NEGATIVE_PROBE_RPC_ERROR"],
+  ["empty-revert", "INVALID_REVERT_DATA"], ["wrong-revert", "UNEXPECTED_REVERT"], ["trailing-revert", "INVALID_REVERT_DATA"], ["negative-success", "NEGATIVE_PROBE_SUCCEEDED"],
+  ["expired-permit", "PERMIT_EXPIRED_AT_CHECKPOINT"], ["wrong-permit-target", "PERMIT_TARGET_MISMATCH"],
+  ["wrong-receipt-hash", "TRANSACTION_IDENTITY_MISMATCH"], ["wrong-receipt-block", "TRANSACTION_BLOCK_MISMATCH"],
+  ["reorg", "BLOCK_CHANGED"], ["chain-change", "NETWORK_CHANGED"], ["wrong-state", "CHECKPOINT_STATE_MISMATCH"],
+]) {
+  test("Sepolia record refuses " + mode, async () => {
+    const f = sepoliaFixture(mode);
+    await assert.rejects(verifySepoliaDeployment(f.client, f.deployment, f.artifact), error => error instanceof SepoliaVerificationError && error.code === code);
+  });
+}
+
+test("unsupported canonical state has no latest or number fallback", async () => {
+  const f = sepoliaFixture("unsupported-hash");
+  await assert.rejects(verifySepoliaDeployment(f.client, f.deployment, f.artifact));
+  const code = f.calls.filter(c => c.method === "eth_getCode"); assert.equal(code.length, 1); assert.equal(code[0].params[1].requireCanonical, true);
+  assert(!f.calls.some(c => c.params?.includes("latest")));
+});
+
+test("different compiled bytecode fails before network rather than changing recorded hashes", async () => {
+  const f = sepoliaFixture(); f.artifact.bytecode = "0x60026000";
+  await assert.rejects(verifySepoliaDeployment(f.client, f.deployment, f.artifact), error => error.code === "ARTIFACT_RECORD_MISMATCH");
+  assert.equal(f.calls.length, 0);
+});
+
+test("malformed record and invalid immutable ranges fail before network", async () => {
+  for (const change of [f => { f.deployment.postDeploymentValidation.transactionBlocks.permit = -1; },
+    f => { f.deployment.postDeploymentValidation.transactions.permit = f.deployment.deploymentTransaction; },
+    f => { f.deployment.postDeploymentValidation.finalState.totalSupply = "9".repeat(79); },
+    f => { f.artifact.immutableReferences = { x: [{ start: 0, length: 32 }] }; }]) {
+    const f = sepoliaFixture(); change(f);
+    await assert.rejects(verifySepoliaDeployment(f.client, f.deployment, f.artifact), error => ["INVALID_RECORD", "INVALID_ARTIFACT"].includes(error.code));
+    assert.equal(f.calls.length, 0);
+  }
+});
diff --git a/test/support/sepolia-cli-fixture.mjs b/test/support/sepolia-cli-fixture.mjs
new file mode 100644
index 0000000..9765dfb
--- /dev/null
+++ b/test/support/sepolia-cli-fixture.mjs
@@ -0,0 +1,46 @@
+import { createServer } from "node:http";
+import { execFile } from "node:child_process";
+import { mkdtempSync, mkdirSync, copyFileSync, readdirSync, readFileSync, writeFileSync, rmSync, lstatSync } from "node:fs";
+import { dirname, join, resolve, basename } from "node:path";
+import { fileURLToPath } from "node:url";
+import { sepoliaFixture } from "./sepolia-fixture.mjs";
+
+const root = fileURLToPath(new URL("../../", import.meta.url)), testRoot = join(root, "test");
+export async function runSepoliaCli(mode = "success", sourceOverride, options = {}) {
+  const fixture = sepoliaFixture(mode), temporary = mkdtempSync(join(testRoot, ".sepolia-cli-"));
+  let child, watchdog, bodyStarted;
+  const server = createServer(async (request, response) => {
+    let body = ""; for await (const chunk of request) body += chunk;
+    const query = JSON.parse(body), reply = fixture.reply(query);
+    response.writeHead(200, { "content-type": "application/json" });
+    if (mode === "stalled-body") {
+      response.write('{"result":"test-only-secret'); bodyStarted = performance.now();
+      watchdog = setTimeout(() => child.kill(), 15000); return;
+    }
+    response.end(JSON.stringify({ jsonrpc: "2.0", id: query.id, ...reply }));
+  });
+  try {
+    for (const folder of ["scripts", "src", "deployments/reference"]) mkdirSync(join(temporary, folder), { recursive: true });
+    writeFileSync(join(temporary, "package.json"), '{"type":"module"}\n');
+    for (const name of readdirSync(join(root, "src")).filter(name => name.endsWith(".js"))) copyFileSync(join(root, "src", name), join(temporary, "src", name));
+    writeFileSync(join(temporary, "scripts/verify-base-sepolia.js"), sourceOverride ?? readFileSync(join(root, "scripts/verify-base-sepolia.js")));
+    writeFileSync(join(temporary, "deployments/base-sepolia.json"), JSON.stringify(fixture.deployment));
+    const artifactPath = join(temporary, options.useArtifactArgument ? "reference artifact.json" : "deployments/reference/DATCore-base-sepolia.json");
+    writeFileSync(artifactPath, JSON.stringify(fixture.artifact));
+    await new Promise(resolve => server.listen(0, "127.0.0.1", resolve));
+    const env = { PATH: process.env.PATH, SYSTEMROOT: process.env.SYSTEMROOT, BASE_SEPOLIA_RPC_URL: "http://127.0.0.1:" + server.address().port + "/?apiKey=test-only-secret-url" };
+    const args = options.useArtifactArgument ? ["--artifact", artifactPath] : options.args ?? [];
+    const result = await new Promise((resolve, reject) => { child = execFile(process.execPath, [join(temporary, "scripts/verify-base-sepolia.js"), ...args],
+      { env, windowsHide: true, timeout: 45000, maxBuffer: 65536 }, (error, stdout, stderr) => {
+        if (error && (error.killed || typeof error.code !== "number")) reject(error);
+        else resolve({ code: error?.code ?? 0, stdout, stderr, calls: fixture.calls, bodyElapsedMs: bodyStarted === undefined ? null : performance.now() - bodyStarted });
+      }); });
+    return result;
+  } finally {
+    clearTimeout(watchdog);
+    server.closeAllConnections(); await new Promise(resolve => server.close(resolve));
+    // Only remove the directory this invocation created beneath this test folder.
+    if (dirname(resolve(temporary)) !== resolve(testRoot) || !basename(temporary).startsWith(".sepolia-cli-") || lstatSync(temporary).isSymbolicLink()) throw Error("Unexpected fixture cleanup path");
+    rmSync(temporary, { recursive: true, force: true });
+  }
+}
diff --git a/test/support/sepolia-fixture.mjs b/test/support/sepolia-fixture.mjs
